# Cloudflare applies every matching rule, so keep Cache-Control on specific
# paths only — repeating it under /* would emit two conflicting headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # No third party can receive what you paste into the editor. Fonts are the
  # only outbound request the page makes; drop those two font lines once you
  # vendor the woff2 files locally (see the README).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'

/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/icon-192.png
  Cache-Control: public, max-age=604800

/icon-512.png
  Cache-Control: public, max-age=604800

/icon-maskable-512.png
  Cache-Control: public, max-age=604800

/icon.svg
  Cache-Control: public, max-age=604800
