{
  "id": "/",
  "name": "Branch — structural JSON editor",
  "short_name": "Branch",
  "description": "A JSON editor that works on the tree: select every node at the same structural position and edit them together.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#eaeeef",
  "theme_color": "#0c6b76",
  "categories": ["developer", "utilities", "productivity"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "JSON document",
      "accept": {
        "application/json": [".json", ".geojson", ".jsonc"],
        "application/geo+json": [".geojson"],
        "text/plain": [".json"]
      },
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": "navigate-new" },
  "shortcuts": [
    { "name": "New document", "url": "/?new=1" }
  ]
}
